# Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Display Settings
plt.style.use("ggplot")
sns.set_theme(style="whitegrid")

# Load Dataset
df = pd.read_csv("netflix_titles.csv")

# -------------------------------
# Basic Information
# -------------------------------
print("\nFirst 5 Rows")
print(df.head())

print("\nDataset Shape")
print(df.shape)

print("\nDataset Information")
print(df.info())

print("\nMissing Values")
print(df.isnull().sum())

print("\nDuplicate Records")
print(df.duplicated().sum())

# -------------------------------
# Data Cleaning
# -------------------------------
df.fillna("Unknown", inplace=True)
df.drop_duplicates(inplace=True)

# Convert date_added to datetime
df["date_added"] = pd.to_datetime(df["date_added"], errors="coerce")

# Create Year Added Column
df["year_added"] = df["date_added"].dt.year

# -------------------------------
# Summary Statistics
# -------------------------------
print("\nSummary Statistics")
print(df.describe(include="all"))

# -------------------------------
# 1. Movies vs TV Shows
# -------------------------------
plt.figure(figsize=(6,4))
sns.countplot(x="type", data=df)
plt.title("Movies vs TV Shows")
plt.xlabel("Type")
plt.ylabel("Count")
plt.show()

# -------------------------------
# 2. Ratings Distribution
# -------------------------------
plt.figure(figsize=(10,6))
sns.countplot(
    y="rating",
    data=df,
    order=df["rating"].value_counts().index
)
plt.title("Content Ratings")
plt.show()

# -------------------------------
# 3. Top 10 Countries
# -------------------------------
top_countries = df["country"].value_counts().head(10)

plt.figure(figsize=(10,5))
sns.barplot(
    x=top_countries.values,
    y=top_countries.index
)
plt.title("Top 10 Countries")
plt.xlabel("Number of Titles")
plt.show()

# -------------------------------
# 4. Content Added by Year
# -------------------------------
plt.figure(figsize=(12,5))
sns.countplot(
    x="year_added",
    data=df,
    order=sorted(df["year_added"].dropna().unique())
)
plt.xticks(rotation=90)
plt.title("Content Added Each Year")
plt.show()

# -------------------------------
# 5. Release Year Distribution
# -------------------------------
plt.figure(figsize=(10,5))
sns.histplot(df["release_year"], bins=30)
plt.title("Release Year Distribution")
plt.xlabel("Release Year")
plt.show()

# -------------------------------
# 6. Top Genres
# -------------------------------
top_genres = df["listed_in"].value_counts().head(10)

plt.figure(figsize=(10,6))
sns.barplot(
    x=top_genres.values,
    y=top_genres.index
)
plt.title("Top 10 Genres")
plt.xlabel("Count")
plt.show()

# -------------------------------
# 7. Movie Duration
# -------------------------------
movies = df[df["type"] == "Movie"].copy()

movies["duration"] = (
    movies["duration"]
    .str.replace(" min", "", regex=False)
)

movies = movies[movies["duration"] != "Unknown"]

movies["duration"] = movies["duration"].astype(int)

plt.figure(figsize=(10,5))
sns.histplot(movies["duration"], bins=25)
plt.title("Movie Duration Distribution")
plt.xlabel("Duration (Minutes)")
plt.show()

# -------------------------------
# 8. Correlation Heatmap
# -------------------------------
numeric_df = df.select_dtypes(include=["number"])

if not numeric_df.empty:
    plt.figure(figsize=(6,4))
    sns.heatmap(
        numeric_df.corr(),
        annot=True,
        cmap="coolwarm"
    )
    plt.title("Correlation Heatmap")
    plt.show()

# -------------------------------
# Final Insights
# -------------------------------
print("\n========== KEY INSIGHTS ==========")
print("1. Movies are more common than TV Shows.")
print("2. Most Netflix content was released after 2010.")
print("3. USA contributes the highest number of titles.")
print("4. TV-MA and TV-14 are the most common ratings.")
print("5. Most movies have a duration between 90 and 120 minutes.")
print("==================================")
